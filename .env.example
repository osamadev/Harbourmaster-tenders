# --- Gemini ------------------------------------------------------------------
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini's OpenAI-compatible endpoint. Usually leave as-is.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Models. Defaults are stable GA models so a demo never breaks.
# To showcase Gemini 3, set these to the current preview IDs from Google AI
# Studio (e.g. gemini-3-pro-preview / gemini-3-flash-preview). VERIFY the exact
# names in AI Studio first — preview model IDs change without notice.
GEMINI_ANALYST_MODEL=gemini-2.5-pro
GEMINI_DRAFTER_MODEL=gemini-2.5-flash

# --- Deployment modes ---------------------------------------------------------
PHOENIX_MODE=local
ELASTIC_MODE=local

# --- Arize Phoenix ------------------------------------------------------------
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_CONSOLE_URL=http://localhost:6006
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=harbourmaster

# --- Elastic -----------------------------------------------------------------
ELASTIC_ENABLED=true
ELASTIC_URL=http://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=harbourmaster-elastic-local
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=harbourmaster

# --- MCP (Governance Copilot) -------------------------------------------------
MCP_ENABLED=true
MCP_PHOENIX_ENABLED=true
MCP_ELASTIC_ENABLED=true
MCP_PHOENIX_PACKAGE=@arizeai/phoenix-mcp@4.0.13
MCP_ELASTIC_PACKAGE=@elastic/mcp-server-elasticsearch@0.4.0
MCP_LOAD_TIMEOUT_SEC=45

# --- Workflow governance ------------------------------------------------------
# Analyst overall_risk at/above this value pauses the workflow for human review.
REVIEW_RISK_THRESHOLD=0.6
VERIFIER_MAX_REVISIONS=1
COMPLIANCE_SPECIALIST_WEIGHT=1.3

# --- Docker / local app -------------------------------------------------------
UI_PORT=8501
PHOENIX_PORT=6006
ELASTIC_PORT=9200
