# Copy to .env.docker (or pass with --env-file) before running docker compose.

# Start ui + phoenix + elastic by default (no --profile flag required)
COMPOSE_PROFILES=local

# Required Gemini secret
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Models and workflow tuning
GEMINI_ANALYST_MODEL=gemini-2.5-pro
GEMINI_DRAFTER_MODEL=gemini-2.5-flash
REVIEW_RISK_THRESHOLD=0.6
COMPLIANCE_SPECIALIST_WEIGHT=1.3

# Deployment modes (per-service local vs cloud)
PHOENIX_MODE=local
ELASTIC_MODE=local
RUNNING_IN_DOCKER=1

# Phoenix (self-hosted in Compose local profile)
PHOENIX_BASE_URL=http://phoenix:6006
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
# Browser-facing Phoenix URL (set to your VPS public host when deployed remotely)
PHOENIX_CONSOLE_URL=http://localhost:6006
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=harbourmaster
# Optional: Phoenix UI uses project ID in /projects/{id} links (auto-resolved from name if unset)
PHOENIX_PROJECT_ID=
PHOENIX_REDTEAM_DATASET=red-team-dataset
PHOENIX_REDTEAM_EXPERIMENT=redteam-latest

# Elastic (self-hosted in Compose local profile)
ELASTIC_ENABLED=true
ELASTIC_URL=http://elastic:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=harbourmaster-elastic-local
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=harbourmaster

# MCP
MCP_ENABLED=true
MCP_PHOENIX_ENABLED=true
MCP_ELASTIC_ENABLED=true
MCP_PHOENIX_PACKAGE=@arizeai/phoenix-mcp@4.0.13
MCP_ELASTIC_PACKAGE=@elastic/mcp-server-elasticsearch@0.4.0
MCP_LOAD_TIMEOUT_SEC=45

# Host publish ports
UI_PORT=8501
PHOENIX_PORT=6006
ELASTIC_PORT=9200

# -----------------------------------------------------------------------------
# Authentication (login / registration / guest access)
# -----------------------------------------------------------------------------
# Master switch. Leave false for local dev (no gate, uses env key). Set true to
# require sign-in / guest key on a public deployment.
AUTH_ENABLED=false
# Allow the "continue as guest with your own Gemini key" path.
ALLOW_ANONYMOUS=true
# Cookie session (set a long random AUTH_COOKIE_KEY in production).
AUTH_COOKIE_NAME=harbourmaster_auth
AUTH_COOKIE_KEY=change-me-to-a-long-random-string
AUTH_COOKIE_EXPIRY_DAYS=7
# Comma-separated emails allowed to edit server secrets on the Configuration page.
ADMIN_EMAILS=you@example.com

# Google OAuth (optional — enables "Login with Google").
# Redirect URI must EXACTLY match the one set in the Google Cloud console
# (e.g. http://localhost:8501/ locally, https://your-domain/ in production).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501/

# Owner email notifications on registration/login (SMTP).
NOTIFY_ENABLED=true
OWNER_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Deprecated: PHOENIX_BASE_URL_DOCKER / ELASTIC_URL_DOCKER — set PHOENIX_BASE_URL
# and ELASTIC_URL directly (see values above). Compose no longer requires *_DOCKER.
