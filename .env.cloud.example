# Cloud-oriented profile for Harbourmaster (UI-only Compose stack).
# Copy to .env.cloud and fill in real API keys before: make run-cloud
# Do not set COMPOSE_PROFILES=local here — cloud runs UI only.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_ANALYST_MODEL=gemini-2.5-pro
GEMINI_DRAFTER_MODEL=gemini-2.5-flash

# Phoenix Cloud
PHOENIX_MODE=cloud
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
PHOENIX_CONSOLE_URL=https://app.phoenix.arize.com
PHOENIX_API_KEY=your-phoenix-cloud-api-key
PHOENIX_PROJECT_NAME=harbourmaster
PHOENIX_PROJECT_ID=
# elasticsearch-py emits its own OTel spans (cluster.health/index/search) that
# clutter Phoenix. Disabled in code by default; set "true" to bring them back.
# OTEL_PYTHON_INSTRUMENTATION_ELASTICSEARCH_ENABLED=false
# Write automated governance evaluations (guard verdict / risk / decision, red-team
# pass-fail) as Phoenix span annotations. Requires PHOENIX_BASE_URL to point at the
# same Phoenix the spans are sent to. Set "false" to disable.
# PHOENIX_ANNOTATIONS_ENABLED=true

# Elastic Cloud (or set ELASTIC_MODE=local if keeping self-hosted Elastic)
ELASTIC_MODE=cloud
ELASTIC_ENABLED=true
ELASTIC_URL=https://your-deployment.es.region.cloud.es.io:443
ELASTIC_API_KEY=your-elastic-cloud-api-key
ELASTIC_INDEX_PREFIX=harbourmaster

# MCP
MCP_ENABLED=true
MCP_PHOENIX_ENABLED=true
MCP_ELASTIC_ENABLED=true
MCP_PHOENIX_PACKAGE=@arizeai/phoenix-mcp@4.0.14
MCP_ELASTIC_PACKAGE=@elastic/mcp-server-elasticsearch@0.3.1
MCP_LOAD_TIMEOUT_SEC=45
MCP_DATA_FIRST=true

UI_PORT=8501
RUNNING_IN_DOCKER=1
